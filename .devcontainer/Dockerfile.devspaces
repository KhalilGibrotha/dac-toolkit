# Dev Spaces / OpenShift-compatible image
# Handles arbitrary UIDs (OpenShift security model) and uses UBI base.
#
# Build and push to your internal registry:
#   podman build -f .devcontainer/Dockerfile.devspaces -t <registry>/dac-toolkit:latest .
#   podman push <registry>/dac-toolkit:latest
#
# Base pinned by digest so a rebuild reproduces the same bytes. The digest is a
# multi-arch manifest list, so multi-arch builds still work. The tag is recorded
# for humans only; Dependabot bumps the digest (see .github/dependabot.yml), and
# the CI vulnerability gate catches the base going stale between bumps.
# Resolved from ubi9/python-312:latest on 2026-07-21.
FROM registry.access.redhat.com/ubi9/python-312@sha256:cc8ec211f2e92279db55b1ee286b7eca55d9fb745fe4543a03d5868bfad0ba37

USER 0

# ── Disable subscription-only repos (allows building outside RHEL/OpenShift) ─
# The UBI9 base ships with both free UBI repos and subscription-gated RHEL repos.
# Outside a subscribed host the RHEL repos 403, so we disable them. The free
# ubi-9-* repos provide everything we need. Inside OpenShift (where the host IS
# subscribed) both repo sets work, so this is safe either way.
RUN dnf config-manager --set-disabled rhel-9-for-x86_64-appstream-rpms \
                                      rhel-9-for-x86_64-baseos-rpms 2>/dev/null; \
    true

# ── System dependencies for Chromium (Puppeteer) and Pandoc ──────────────────
RUN dnf install -y --nodocs \
    # Chromium runtime libraries
    nss atk at-spi2-atk cups-libs libdrm \
    libXcomposite libXdamage libXrandr mesa-libgbm pango \
    cairo alsa-lib libxshmfence libxkbcommon \
    # Git and GitHub CLI
    git \
    # Utilities
    jq \
    && dnf install -y --nodocs https://github.com/cli/cli/releases/download/v2.67.0/gh_2.67.0_linux_amd64.rpm \
    && dnf clean all

# ── Pandoc (direct binary — not available in free UBI repos) ─────────────────
ARG PANDOC_VERSION=3.6.4
RUN curl -fsSL "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz" \
    | tar xz --strip-components=2 -C /usr/local/bin "pandoc-${PANDOC_VERSION}/bin/pandoc"

# ── Quarto (presentation + document rendering) ───────────────────────────────
# Ships its own bundled pandoc and deno; executable Python chunks use the
# jupyter installed with the Python deps below. Extracted whole so share/ sits
# beside bin/.
ARG QUARTO_VERSION=1.6.40
RUN curl -fsSL "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz" \
    | tar xz -C /opt \
    && ln -s /opt/quarto-${QUARTO_VERSION}/bin/quarto /usr/local/bin/quarto

# ── LibreOffice: deliberately NOT installed ─────────────────────────────
# Verified 2026-07-20: libreoffice-impress is not available from any UBI9 repo
# (ubi-9-appstream, ubi-9-baseos, ubi-9-codeready-builder all report "No
# matching Packages"). A dnf install here can never succeed, so it is omitted
# rather than left as a silently failing layer.
#
# Consequence: render-decks.sh renders .pptx normally in this image; only the
# --qa slide-image gallery (pptx -> pdf -> png) is unavailable, and the script
# reports the skipped gallery and continues rather than failing.
#
# To add it, install from The Document Foundation RPM tarball (~250MB; soffice
# lands under /opt/libreoffice<ver>/program/) rather than via dnf.

# ── Node.js ──────────────────────────────────────────────────────────────────
# The UBI9 python-312 base image includes Node.js (22.x) from the appstream
# module. This is sufficient for mmdc/mermaid-cli. No additional install needed.
# If Node is missing in a future base image, uncomment:
#   RUN dnf module enable -y nodejs:22 && dnf install -y --nodocs nodejs npm && dnf clean all

# ── Mermaid CLI (mmdc) — installs Puppeteer + bundled Chromium ───────────────
ENV PUPPETEER_CACHE_DIR=/opt/puppeteer-cache
ARG MERMAID_CLI_VERSION=11.16.0
RUN npm install -g "@mermaid-js/mermaid-cli@${MERMAID_CLI_VERSION}" \
    && npm cache clean --force \
    && chmod -R g+rx /opt/puppeteer-cache

# Puppeteer launch flags for containerized Chromium
RUN echo '{"args":["--no-sandbox","--disable-setuid-sandbox","--disable-dev-shm-usage"]}' \
    > /opt/puppeteer-config.json \
    && chmod 644 /opt/puppeteer-config.json
ENV PUPPETEER_CONFIG=/opt/puppeteer-config.json

# ── Vale prose linter ─────────────────────────────────────────────────────
ARG VALE_VERSION=3.9.5
COPY .vale-bootstrap.ini /tmp/.vale.ini
RUN curl -fsSL "https://github.com/errata-ai/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_64-bit.tar.gz" \
    | tar xz -C /usr/local/bin vale \
    && cd /tmp && vale sync \
    && mv .vale/styles /opt/vale-styles \
    && chmod -R g+rx /opt/vale-styles \
    && rm .vale.ini

# ── Python dependencies (pre-installed so editable install works offline) ────
RUN pip install --no-cache-dir \
    "python-docx>=1.1.0" \
    "PyYAML>=6.0" \
    "mistune>=3.0" \
    "lxml>=4.9" \
    # deck rendering: jupyter runs Quarto's executable Python chunks;
    # matplotlib draws figures; pymupdf rasterizes slides for the QA gallery
    "jupyter>=1.0" \
    "matplotlib>=3.8" \
    "pymupdf>=1.24"

# ── Bake the toolkit itself into the image ───────────────────────────────────
# The image carries docx_builder (installed) plus the scripts and the
# presentations example, so a CONTENT repo consumes the image without cloning
# the toolkit source. Build context is the repo root (see the build command in
# the header and the docker-build workflow). docx_builder deps are already
# installed above, so --no-deps keeps this offline. Scripts go on PATH; the
# render scripts resolve their bundled example relative to /opt/dac-toolkit.
COPY docx_builder /opt/dac-toolkit/docx_builder
COPY scripts /opt/dac-toolkit/scripts
COPY presentations /opt/dac-toolkit/presentations
COPY diagrams /opt/dac-toolkit/diagrams
RUN pip install --no-cache-dir --no-deps /opt/dac-toolkit/docx_builder \
    && chmod -R g+rx /opt/dac-toolkit
ENV DAC_TOOLKIT_HOME=/opt/dac-toolkit
ENV PATH="/opt/dac-toolkit/scripts:${PATH}"

# ── OpenShift arbitrary UID support ──────────────────────────────────────────
# OpenShift runs containers with a random UID in the root group (GID 0).
# All directories the process writes to must be group-writable.
RUN mkdir -p /home/user /projects \
    && chgrp -R 0 /home/user /opt/puppeteer-cache /opt/vale-styles \
    && chmod -R g=u /home/user /etc/passwd /opt/puppeteer-cache /opt/vale-styles

ENV HOME=/home/user
WORKDIR /projects

USER 1001
