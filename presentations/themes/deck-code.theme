{
  "text-color": "#57C88A",
  "background-color": "#04120B",
  "line-number-color": "#697586",
  "line-number-background-color": null,
  "text-styles": {
    "Keyword": { "text-color": "#4FD1A1", "bold": true },
    "ControlFlow": { "text-color": "#4FD1A1", "bold": true },
    "DataType": { "text-color": "#4EA1F0" },
    "String": { "text-color": "#4EA1F0" },
    "Char": { "text-color": "#4EA1F0" },
    "Comment": { "text-color": "#697586", "italic": true },
    "Documentation": { "text-color": "#697586", "italic": true },
    "Function": { "text-color": "#F5F7FA" },
    "Variable": { "text-color": "#F5F7FA" },
    "Constant": { "text-color": "#E8A44C" },
    "DecVal": { "text-color": "#E8A44C" },
    "Float": { "text-color": "#E8A44C" },
    "BaseN": { "text-color": "#E8A44C" },
    "Alert": { "text-color": "#E8A44C", "bold": true },
    "Error": { "text-color": "#E8A44C", "bold": true },
    "Other": { "text-color": "#57C88A" }
  }
}
