#!/usr/bin/env python3
"""dac-update — sync a repo's managed DaC files to the current stock revision.

Conffile model: for every file dac-init could install, compare the adopter's
current copy against the stock-hash history (every stock revision ever
shipped, see gen-stock-hashes.py) and the new stock version, then act:

  * byte-identical (normalized) to the NEW stock version   -> skip
  * matches ANY earlier known stock hash (unmodified, old) -> replace in place
  * matches no known stock hash (locally customized)       -> write <file>.new
  * missing entirely (added to the managed set since adopt)-> install

A locally customized file is never overwritten. Comparison uses normalized
content (BOM stripped, CRLF -> LF, one trailing newline) so a Windows
checkout's line endings alone never register as a customization.

The manifest's files map records only paths confirmed on stock content this
run (install/replace/skip). A keep+new file is customized by definition, so
its entry is dropped rather than left claiming stock.

Files that left the managed set since the adopter's last sync (removed or
renamed upstream) are reconciled too: an unmodified copy is deleted, a
customized one is left in place and reported as needing a manual decision.

Requires dac/.dac-manifest.json — the record dac-init writes. Run dac-init
first if this repo has never adopted the managed file set.

    dac-update --dry-run       report every action, write nothing
    dac-update                 apply
    dac-update --path <dir>    target a repo other than cwd (skips the .git check)

Outside a workspace:
    podman run --rm -v "$PWD:/work:Z" -w /work \\
      ghcr.io/khalilgibrotha/dac-toolkit:latest dac-update --dry-run
"""
from __future__ import annotations

import argparse
import sys
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from dac_common import (  # noqa: E402
    REPO_MANIFEST, STARTER_DEFAULT, atomic_write_bytes, atomic_write_json,
    load_json, looks_like_repo_root, managed_files, nhash,
)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true", help="report; write nothing")
    ap.add_argument("--path", default=".", help="repo root (default: cwd)")
    ap.add_argument("--starter-dir", default=STARTER_DEFAULT, help=argparse.SUPPRESS)
    args = ap.parse_args()

    repo = Path(args.path).resolve()
    starter = Path(args.starter_dir)
    files_dir = starter / "files"
    manifest = load_json(starter / "manifest.json")
    history = load_json(starter / "stock-hashes.json")

    if not files_dir.is_dir():
        print(f"dac-update: starter tree not found at {files_dir}\n"
              "Run inside the dac-toolkit image, or pass --starter-dir.",
              file=sys.stderr)
        return 3
    if args.path == "." and not looks_like_repo_root(repo):
        print(f"dac-update: {repo} does not look like a repo root (no .git).\n"
              "cd to the repo root or pass --path <dir>.", file=sys.stderr)
        return 3

    record_path = repo / REPO_MANIFEST
    if not record_path.is_file():
        print(f"dac-update: no {REPO_MANIFEST} found in {repo}.\n"
              "This repo has not adopted the managed file set yet — run "
              "dac-init first, then dac-update.", file=sys.stderr)
        return 3
    record = load_json(record_path)

    version = manifest.get("starter_version", "unknown")
    engine = manifest.get("engine_image", "unknown")
    print(f"dac-update (starter {version}, engine {engine})\n")

    counts = {"install": 0, "replace": 0, "keep+new": 0, "skip": 0,
              "remove": 0, "obsolete": 0}
    stock_now = {}    # rel -> hash, confirmed on stock content this run
    customized = []   # rel, keep+new this run -> drop any stale manifest entry

    current = managed_files(files_dir)
    for rel in current:
        src = files_dir / rel
        new_hash = nhash(src)
        dst = repo / rel
        tag = "would " if args.dry_run else ""

        if not dst.exists():
            counts["install"] += 1
            print(f"  {tag}install   {rel}")
            if not args.dry_run:
                atomic_write_bytes(dst, src.read_bytes())
            stock_now[rel] = new_hash
            continue

        cur_hash = nhash(dst)
        known = set(history.get(rel, []))
        known.add(new_hash)  # the stock's own hash is trivially "known stock"

        if cur_hash == new_hash:
            counts["skip"] += 1
            print(f"  skip      {rel}  (already current)")
            stock_now[rel] = new_hash
        elif cur_hash in known:
            counts["replace"] += 1
            print(f"  {tag}replace   {rel}  (unmodified stock, older revision "
                  f"-> {version})")
            if not args.dry_run:
                atomic_write_bytes(dst, src.read_bytes())
            stock_now[rel] = new_hash
        else:
            counts["keep+new"] += 1
            print(f"  keep+new  {rel}  (locally customized -> {rel}.new)")
            if not args.dry_run:
                atomic_write_bytes(dst.with_name(dst.name + ".new"), src.read_bytes())
            customized.append(rel)

    # Files that left the managed set since the adopter last synced: gone
    # from the stock tree today, but either recorded in the manifest or
    # present somewhere in stock-hashes.json history. An unmodified copy is
    # safe to delete; a customized one is left for a human to decide.
    stale = []  # rel, no longer managed either way -> drop any manifest entry
    previously_managed = set(record.get("files", {})) | set(history)
    for rel in sorted(previously_managed - set(current)):
        dst = repo / rel
        if not dst.exists():
            continue
        cur_hash = nhash(dst)
        tag = "would " if args.dry_run else ""
        if cur_hash in set(history.get(rel, [])):
            counts["remove"] += 1
            print(f"  {tag}remove    {rel}  (unmodified, no longer managed)")
            if not args.dry_run:
                dst.unlink()
        else:
            counts["obsolete"] += 1
            print(f"  obsolete  {rel}  (customized, left the managed set -- "
                  "review and decide by hand)")
        stale.append(rel)

    if not args.dry_run:
        record.setdefault("dac_manifest_version", 1)
        record.setdefault("installed", date.today().isoformat())  # never overwrite if present
        record["starter_version"] = version
        record["engine_image"] = engine
        record["updated"] = date.today().isoformat()
        files_map = record.setdefault("files", {})
        files_map.update(stock_now)
        for rel in customized:
            files_map.pop(rel, None)
        for rel in stale:
            files_map.pop(rel, None)
        atomic_write_json(record_path, record)

    verb = "would be " if args.dry_run else ""
    print(f"\n{counts['install']} installed, {counts['replace']} replaced, "
          f"{counts['keep+new']} {verb}left as-is with a .new written for review, "
          f"{counts['skip']} already current, {counts['remove']} {verb}removed "
          f"(unmodified, no longer managed), {counts['obsolete']} flagged obsolete "
          "(customized, kept).")
    if counts["keep+new"]:
        print("Review the .new file(s), merge what you want, then delete the .new copy.")
    if counts["obsolete"]:
        print("Obsolete customized file(s) were left in place. Decide by hand whether "
              "to keep or delete them.")
    if args.dry_run and any(counts[k] for k in
                             ("install", "replace", "keep+new", "remove")):
        print("Run without --dry-run to apply.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
